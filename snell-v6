#!/usr/bin/env bash
set -Eeuo pipefail

SNELL_VERSION="${SNELL_VERSION:-6.0.0}"
SNELL_PORT="${SNELL_PORT:-}"
SNELL_PSK="${SNELL_PSK:-}"
SNELL_MODE="${SNELL_MODE:-default}"
ENABLE_IPV6="${ENABLE_IPV6:-0}"
DNS_IP_PREFERENCE="${DNS_IP_PREFERENCE:-default}"
ACTION="${1:-}"
PURGE_CONFIG=0

SERVICE_NAME="snell-v6"
SERVICE_USER="nobody"
SERVICE_GROUP="nogroup"
INIT_SYSTEM=""

CONFIG_DIR="/etc/snell-v6"
CONFIG_FILE="${CONFIG_DIR}/snell-server.conf"
SERVICE_FILE=""
BIN_FILE="/usr/local/bin/snell-server-v6"
CLIENT_FILE="/root/snell-v6-client.conf"
BBR_SYSCTL_FILE="/etc/sysctl.d/99-snell-v6-bbr.conf"
BBR_MODULES_FILE="/etc/modules-load.d/snell-v6-bbr.conf"

OLD_SELF_SERVICE_FILE="/etc/systemd/system/snell.service"

usage() {
  cat <<'EOF'
Usage: snell-v6 [install|upgrade|reinstall|uninstall] [--purge]

  install      安装 Snell v6；保留已有配置 / Install Snell v6; preserve existing configuration
  upgrade      升级程序；保留配置 / Upgrade the binary and service; preserve configuration
  reinstall    重新安装；保留配置 / Reinstall the binary and service; preserve configuration
  uninstall    卸载程序；默认保留配置 / Uninstall Snell v6; preserve configuration by default
  --purge      卸载时同时删除配置 / Also remove server and client configuration on uninstall
EOF
}

choose_action() {
  local choice

  [[ -n "${ACTION}" ]] && return 0
  if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
    ACTION="install"
    return 0
  fi

  cat >/dev/tty <<'EOF'

========== Snell v6 ==========
1) 安装 / Install
2) 升级（保留配置）/ Upgrade (keep configuration)
3) 重新安装（保留配置）/ Reinstall (keep configuration)
4) 卸载（保留配置）/ Uninstall (keep configuration)
5) 彻底卸载（删除配置）/ Uninstall and remove configuration
0) 退出 / Exit
EOF
  read -r -p "请选择 / Choose [0-5]: " choice </dev/tty
  case "${choice}" in
    1) ACTION="install" ;;
    2) ACTION="upgrade" ;;
    3) ACTION="reinstall" ;;
    4) ACTION="uninstall" ;;
    5) ACTION="uninstall"; PURGE_CONFIG=1 ;;
    0) exit 0 ;;
    *) die "Invalid choice: ${choice}" ;;
  esac
}

parse_args() {
  local arg
  choose_action
  for arg in "$@"; do
    case "${arg}" in
      install | upgrade | reinstall | uninstall) ACTION="${arg}" ;;
      --purge) PURGE_CONFIG=1 ;;
      -h | --help) usage; exit 0 ;;
      *) die "Unknown option: ${arg}" ;;
    esac
  done

  case "${ACTION}" in
    install | upgrade | reinstall | uninstall) ;;
    *) usage; die "Unknown action: ${ACTION}" ;;
  esac
  [[ "${PURGE_CONFIG}" -eq 0 || "${ACTION}" == "uninstall" ]] ||
    die "--purge can only be used with uninstall"
}

log() {
  echo "[snell-v6] $*"
}

die() {
  echo "[snell-v6] ERROR: $*" >&2
  exit 1
}

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    die "Please run as root, for example: sudo bash snell-v6"
  fi
}

detect_init_system() {
  if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    INIT_SYSTEM="systemd"
    SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
  elif command -v rc-service >/dev/null 2>&1 && command -v rc-update >/dev/null 2>&1; then
    INIT_SYSTEM="openrc"
    SERVICE_FILE="/etc/init.d/${SERVICE_NAME}"
  else
    die "Neither a running systemd nor OpenRC installation was found. Install systemd or OpenRC first (on Alpine: apk add openrc)."
  fi
}

detect_arch() {
  local machine
  machine="$(uname -m)"

  case "${machine}" in
    x86_64 | amd64)
      echo "amd64"
      ;;
    aarch64 | arm64)
      echo "aarch64"
      ;;
    armv7l | armv7)
      echo "armv7l"
      ;;
    i386 | i686)
      echo "i386"
      ;;
    *)
      die "Unsupported architecture: ${machine}"
      ;;
  esac
}

random_port() {
  local port

  while true; do
    port="$(shuf -i 20000-60999 -n 1)"
    if ! ss -lntH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"; then
      echo "${port}"
      return
    fi
  done
}

random_psk() {
  openssl rand -hex 32
}

read_existing_config() {
  local listen_value existing_port existing_psk existing_dns_ip_preference

  [[ -f "${CONFIG_FILE}" ]] || return 0

  listen_value="$(awk -F '=' '/^[[:space:]]*listen[[:space:]]*=/{gsub(/[[:space:]]/, "", $2); print $2; exit}' "${CONFIG_FILE}")"
  existing_port="$(printf '%s\n' "${listen_value}" | sed -E 's/.*:([0-9]+)(,.*)?$/\1/')"
  existing_psk="$(awk -F '=' '/^[[:space:]]*psk[[:space:]]*=/{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' "${CONFIG_FILE}")"
  existing_dns_ip_preference="$(awk -F '=' '/^[[:space:]]*dns-ip-preference[[:space:]]*=/{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' "${CONFIG_FILE}")"

  if [[ -z "${SNELL_PORT}" && "${existing_port}" =~ ^[0-9]+$ ]]; then
    SNELL_PORT="${existing_port}"
  fi

  if [[ -z "${SNELL_PSK}" && -n "${existing_psk}" ]]; then
    SNELL_PSK="${existing_psk}"
  fi

  if [[ "${DNS_IP_PREFERENCE}" == "default" && -n "${existing_dns_ip_preference}" ]]; then
    DNS_IP_PREFERENCE="${existing_dns_ip_preference}"
  fi
}

install_deps() {
  log "Installing dependencies..."

  if command -v apk >/dev/null 2>&1; then
    apk add --no-cache bash ca-certificates wget unzip curl openssl iproute2 coreutils gcompat libstdc++ libgcc procps openrc
    return
  fi

  if command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y ca-certificates wget unzip curl openssl iproute2 coreutils procps
    return
  fi

  if command -v dnf >/dev/null 2>&1; then
    dnf install -y ca-certificates wget unzip curl openssl iproute coreutils procps-ng
    return
  fi

  if command -v yum >/dev/null 2>&1; then
    yum install -y ca-certificates wget unzip curl openssl iproute coreutils procps-ng
    return
  fi

  die "Unsupported package manager. Please install wget, unzip, curl, openssl, iproute/iproute2 and coreutils manually."
}

ensure_service_identity() {
  if ! id -u "${SERVICE_USER}" >/dev/null 2>&1; then
    SERVICE_USER="root"
    SERVICE_GROUP="root"
    return
  fi

  if ! getent group "${SERVICE_GROUP}" >/dev/null 2>&1; then
    SERVICE_GROUP="$(id -gn "${SERVICE_USER}")"
  fi
}

cleanup_old_self_service() {
  [[ "${INIT_SYSTEM}" == "systemd" ]] || return 0
  if [[ -f "${OLD_SELF_SERVICE_FILE}" ]] &&
    grep -q "/usr/local/bin/snell-server -c /etc/snell/snell-server.conf" "${OLD_SELF_SERVICE_FILE}"; then
    log "Removing old snell.service created by the previous script..."
    systemctl disable --now snell >/dev/null 2>&1 || true
    rm -f "${OLD_SELF_SERVICE_FILE}"
    systemctl daemon-reload || true
  fi
}

install_snell() {
  local arch url tmp_dir zip_file
  arch="$(detect_arch)"

  if [[ "${SNELL_VERSION}" == 6.* && "${arch}" == "armv7l" ]]; then
    die "Snell v${SNELL_VERSION} does not provide an official linux-armv7l build. Please use amd64, aarch64 or i386."
  fi

  url="https://dl.nssurge.com/snell/snell-server-v${SNELL_VERSION}-linux-${arch}.zip"
  tmp_dir="$(mktemp -d)"
  zip_file="${tmp_dir}/snell-server.zip"

  log "Downloading Snell Server v${SNELL_VERSION} for linux-${arch}..."
  wget -qO "${zip_file}" "${url}" || die "Download failed: ${url}"
  unzip -oq "${zip_file}" -d "${tmp_dir}"

  if [[ ! -f "${tmp_dir}/snell-server" ]]; then
    rm -rf "${tmp_dir}"
    die "snell-server binary was not found in the downloaded archive"
  fi

  install -m 755 "${tmp_dir}/snell-server" "${BIN_FILE}"
  rm -rf "${tmp_dir}"
}

write_config() {
  local listen_value tmp_file

  if [[ -z "${SNELL_PORT}" ]]; then
    SNELL_PORT="$(random_port)"
  fi

  if [[ -z "${SNELL_PSK}" ]]; then
    SNELL_PSK="$(random_psk)"
  fi

  if [[ "${ENABLE_IPV6}" == "1" || "${ENABLE_IPV6}" == "true" ]]; then
    listen_value="0.0.0.0:${SNELL_PORT},[::]:${SNELL_PORT}"
  else
    listen_value="0.0.0.0:${SNELL_PORT}"
  fi

  install -d -m 750 -o root -g "${SERVICE_GROUP}" "${CONFIG_DIR}"
  tmp_file="$(mktemp)"
  cat >"${tmp_file}" <<EOF
[snell-server]
listen = ${listen_value}
psk = ${SNELL_PSK}
mode = ${SNELL_MODE}
dns-ip-preference = ${DNS_IP_PREFERENCE}
EOF

  install -m 640 -o root -g "${SERVICE_GROUP}" "${tmp_file}" "${CONFIG_FILE}"
  rm -f "${tmp_file}"
}

backup_config() {
  local backup_file
  [[ -f "${CONFIG_FILE}" ]] || return 0
  backup_file="${CONFIG_FILE}.bak.$(date +%Y%m%d%H%M%S)"
  cp -a "${CONFIG_FILE}" "${backup_file}"
  log "Configuration backup: ${backup_file}"
}

write_service() {
  if [[ "${INIT_SYSTEM}" == "openrc" ]]; then
    cat >"${SERVICE_FILE}" <<EOF
#!/sbin/openrc-run
description="Snell v6 Proxy Service"
command="${BIN_FILE}"
command_args="-c ${CONFIG_FILE}"
command_user="${SERVICE_USER}:${SERVICE_GROUP}"
command_background="no"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0

depend() {
  need net
  after firewall
}
EOF
    chmod 755 "${SERVICE_FILE}"
    return
  fi

  cat >"${SERVICE_FILE}" <<EOF
[Unit]
Description=Snell v6 Proxy Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SERVICE_USER}
Group=${SERVICE_GROUP}
LimitNOFILE=32768
ExecStart=${BIN_FILE} -c ${CONFIG_FILE}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
}

open_firewall_if_needed() {
  if command -v ufw >/dev/null 2>&1 && ufw status | grep -qi "Status: active"; then
    log "Opening TCP ${SNELL_PORT} in UFW..."
    ufw allow "${SNELL_PORT}/tcp"
  fi

  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    log "Opening TCP ${SNELL_PORT} in firewalld..."
    firewall-cmd --permanent --add-port="${SNELL_PORT}/tcp" >/dev/null
    firewall-cmd --reload >/dev/null
  fi
}

enable_bbr_fq() {
  log "Enabling BBR congestion control with the fq queue discipline..."

  install -d -m 755 /etc/sysctl.d /etc/modules-load.d
  cat >"${BBR_MODULES_FILE}" <<'EOF'
tcp_bbr
sch_fq
EOF
  cat >"${BBR_SYSCTL_FILE}" <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF

  command -v modprobe >/dev/null 2>&1 && {
    modprobe tcp_bbr >/dev/null 2>&1 || true
    modprobe sch_fq >/dev/null 2>&1 || true
  }

  if ! command -v sysctl >/dev/null 2>&1; then
    log "WARNING: sysctl was not found; BBR/fq will be applied after reboot if supported."
    return
  fi

  if sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 &&
    sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1; then
    log "BBR/fq enabled successfully."
  else
    log "WARNING: The current kernel or environment could not enable BBR/fq; persistent settings were still saved."
  fi
}

format_host_for_surge() {
  local host="$1"

  if [[ "${host}" == *:* && "${host}" != \[* ]]; then
    echo "[${host}]"
  else
    echo "${host}"
  fi
}

public_ip() {
  local ip
  ip="$(curl -4fsS --max-time 6 https://api.ipify.org 2>/dev/null || true)"

  if [[ -z "${ip}" ]]; then
    ip="$(curl -4fsS --max-time 6 https://ifconfig.me 2>/dev/null || true)"
  fi

  if [[ -z "${ip}" && ( "${ENABLE_IPV6}" == "1" || "${ENABLE_IPV6}" == "true" ) ]]; then
    ip="$(curl -6fsS --max-time 6 https://api64.ipify.org 2>/dev/null || true)"
  fi

  if [[ -z "${ip}" ]]; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  fi

  format_host_for_surge "${ip:-YOUR_SERVER_IP}"
}

write_client_config() {
  local server_ip tmp_file
  server_ip="$(public_ip)"
  tmp_file="$(mktemp)"

  cat >"${tmp_file}" <<EOF
# Surge client configuration
# Add this line under the [Proxy] section:

Snell-v6 = snell, ${server_ip}, ${SNELL_PORT}, psk=${SNELL_PSK}, version=6, reuse=true
EOF

  install -m 600 -o root -g root "${tmp_file}" "${CLIENT_FILE}"
  rm -f "${tmp_file}"
}

uninstall_snell() {
  log "Stopping and removing ${SERVICE_NAME}..."
  if [[ "${INIT_SYSTEM}" == "openrc" ]]; then
    rc-service "${SERVICE_NAME}" stop >/dev/null 2>&1 || true
    rc-update del "${SERVICE_NAME}" default >/dev/null 2>&1 || true
  else
    systemctl disable --now "${SERVICE_NAME}" >/dev/null 2>&1 || true
  fi
  rm -f "${SERVICE_FILE}" "${BIN_FILE}"
  if [[ "${INIT_SYSTEM}" == "systemd" ]]; then
    systemctl daemon-reload
    systemctl reset-failed "${SERVICE_NAME}" >/dev/null 2>&1 || true
  fi

  if [[ "${PURGE_CONFIG}" -eq 1 ]]; then
    rm -rf "${CONFIG_DIR}"
    rm -f "${CLIENT_FILE}"
    log "Snell v6 and its configuration have been removed."
  else
    log "Snell v6 has been removed. Configuration was preserved:"
    log "  ${CONFIG_DIR}"
    log "  ${CLIENT_FILE}"
  fi
  log "Firewall rules were not changed. Remove the old TCP port rule manually if it is no longer needed."
}

start_service() {
  if [[ "${INIT_SYSTEM}" == "openrc" ]]; then
    rc-update add "${SERVICE_NAME}" default >/dev/null || return 1
    rc-service "${SERVICE_NAME}" restart || return 1
    sleep 1
    rc-service "${SERVICE_NAME}" status >/dev/null 2>&1
    return
  fi

  systemctl daemon-reload || return 1
  systemctl enable "${SERVICE_NAME}" >/dev/null || return 1
  systemctl restart "${SERVICE_NAME}" || return 1
  sleep 1
  systemctl is-active --quiet "${SERVICE_NAME}"
}

print_result() {
  local status="$1"
  local status_command log_command

  if [[ "${INIT_SYSTEM}" == "openrc" ]]; then
    status_command="rc-service ${SERVICE_NAME} status"
    log_command="logread | grep ${SERVICE_NAME}"
  else
    status_command="systemctl status ${SERVICE_NAME} --no-pager"
    log_command="journalctl -u ${SERVICE_NAME} -n 80 --no-pager"
  fi

  echo
  echo "========== Snell v6 =========="
  echo "Status: ${status}"
  echo
  echo "Server config:"
  echo "  ${CONFIG_FILE}"
  echo
  echo "Surge client config:"
  sed 's/^/  /' "${CLIENT_FILE}"
  echo
  echo "Useful commands:"
  echo "  ${status_command}"
  echo "  ${log_command}"
  echo "  cat ${CLIENT_FILE}"
  echo
  echo "If your VPS provider has a cloud firewall/security group, allow TCP ${SNELL_PORT} there too."
}

print_failure_details() {
  echo
  echo "Service failed to start. Recent logs:"
  if [[ "${INIT_SYSTEM}" == "openrc" ]]; then
    rc-service "${SERVICE_NAME}" status || true
    command -v logread >/dev/null 2>&1 && logread | tail -n 80 || true
  else
    journalctl -u "${SERVICE_NAME}" -n 80 --no-pager || true
  fi
}

main() {
  parse_args "$@"
  need_root

  if [[ "${ACTION}" == "uninstall" ]]; then
    detect_init_system
    uninstall_snell
    return
  fi

  install_deps
  detect_init_system
  ensure_service_identity
  cleanup_old_self_service
  read_existing_config
  if [[ -f "${CONFIG_FILE}" ]]; then
    backup_config
  fi
  install_snell
  if [[ ! -f "${CONFIG_FILE}" ]]; then
    write_config
  else
    log "Preserving existing server configuration: ${CONFIG_FILE}"
  fi
  write_service
  write_client_config
  enable_bbr_fq
  open_firewall_if_needed

  if start_service; then
    print_result "running"
  else
    print_result "failed"
    print_failure_details
    exit 1
  fi
}

main "$@"
